<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <section class="hero">
    <h1>Support and Legal Assistance for Single Mothers</h1>
    <p>
      Find verified legal aid, child maintenance support, custody guidance,
      domestic violence protection, and social welfare institutions in one place.
    </p>
    <div class="cta-row">
      <a href="/auth" class="btn-primary">Get Started</a>
      <a href="/dashboard" class="btn-secondary">Browse Support Categories</a>
    </div>
  </section>

  <section class="categories-grid">
    <div class="card">
      <h2>Child Maintenance</h2>
      <p>Support for establishing paternity and securing financial maintenance for your child.</p>
    </div>
    <div class="card">
      <h2>Child Custody</h2>
      <p>Guidance and representation for custody, access, and family court matters.</p>
    </div>
    <div class="card">
      <h2>Domestic Violence</h2>
      <p>Urgent protection, counseling, and legal support for abuse or threats.</p>
    </div>
    <div class="card">
      <h2>Financial & Social Aid</h2>
      <p>Connections to social welfare programs, family mediation, and community aid.</p>
    </div>
  </section>
</main>

<script src="/js/auth.js"></script>
</body>
</html>