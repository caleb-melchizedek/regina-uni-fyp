<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container">
  <section class="card">
    <h1>Admin Management Console</h1>
    <p id="adminStatusBanner" class="message"></p>
  </section>

  <!-- 1. Manage Assistance Requests -->
  <section class="card">
    <h2>Assistance Requests</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Provider</th>
            <th>Category & Urgency</th>
            <th>Summary</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="adminRequestsBody">
          <tr><td colspan="6">Loading requests...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 2. Manage Service Providers -->
  <section class="card">
    <h2>Service Providers</h2>
    <form id="addProviderForm" class="provider-form">
      <label for="provName">Institution Name</label>
      <input type="text" id="provName" required />

      <label for="provCategory">Category</label>
      <select id="provCategory" required>
        <option value="Child Maintenance">Child Maintenance</option>
        <option value="Child Custody">Child Custody</option>
        <option value="Domestic Violence">Domestic Violence</option>
        <option value="Financial & Social Aid">Financial & Social Aid</option>
        <option value="General Legal Aid">General Legal Aid</option>
      </select>

      <label for="provCity">City</label>
      <input type="text" id="provCity" required />

      <label for="provAddress">Address</label>
      <input type="text" id="provAddress" required />

      <label for="provPhone">Contact Phone</label>
      <input type="text" id="provPhone" required />

      <label for="provEmail">Contact Email (optional)</label>
      <input type="email" id="provEmail" />

      <label for="provDesc">Description</label>
      <textarea id="provDesc" rows="3" required></textarea>

      <button type="submit" class="btn-primary">Add Provider</button>
    </form>
    <p id="providerMsg" class="message"></p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Location</th>
            <th>Contact</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="adminProvidersBody">
          <tr><td colspan="5">Loading providers...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 3. Registered Users -->
  <section class="card">
    <h2>Registered Users</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Location</th>
            <th>Role</th>
          </tr>
        </thead>
        <tbody id="adminUsersBody">
          <tr><td colspan="5">Loading users...</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</main>

<script src="/js/auth.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>